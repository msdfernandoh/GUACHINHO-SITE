# Supabase (obrigatório)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Apenas servidor — NUNCA expor no client ou no Vercel "Public"
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# URL do site (OAuth redirects, links absolutos)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Calendar — agenda comercial (somente servidor; Vercel: Production + Preview)
# Redirect no Google Cloud: {NEXT_PUBLIC_SITE_URL}/api/auth/google-calendar/callback
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Vercel: definir as mesmas variáveis no projeto (Production + Preview)
# NEXT_PUBLIC_SITE_URL=https://seu-dominio.vercel.app
