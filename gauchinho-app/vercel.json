{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/indices-financeiros",
      "schedule": "0 11 1 * *"
    },
    {
      "path": "/api/cron/dominios",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/agenda-google",
      "schedule": "*/10 * * * *"
    }
  ]
}
