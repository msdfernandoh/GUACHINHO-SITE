# Copie para .env.local e preencha com o projeto Supabase.
# Template idêntico ao da raiz do repositório (../.env.example).

# Supabase (obrigatório)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Apenas servidor — NUNCA expor no client nem marcar como pública na Vercel
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# URL do site (redirects Auth, links absolutos, sitemap, Search Console)
NEXT_PUBLIC_SITE_URL=https://www.gauchinhoconsorcios.com.br

# Google Calendar — sincronização da agenda comercial (servidor)
# Crie credenciais OAuth "Web application" no Google Cloud Console
# Redirect URI autorizado: {NEXT_PUBLIC_SITE_URL}/api/auth/google-calendar/callback
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# IA comercial (servidor — opcional; sem chave o chat usa fallback + WhatsApp)
OPENAI_API_KEY=
IA_PROVIDER=openai
IA_MODEL=gpt-4o-mini

# Integração privada com o ERP Consórcio (somente servidor)
# Gere uma chave longa e use exatamente o mesmo valor nos dois projetos.
GAUCHINHO_INTEGRATION_API_KEY=

# Produção (Vercel): cadastre as mesmas chaves em Production + Preview
# NEXT_PUBLIC_SITE_URL=https://seu-app.vercel.app
