# Copie para .env.local e preencha com o projeto Supabase.
# Template idêntico ao da raiz do repositório (../.env.example).

# Supabase (obrigatório)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Apenas servidor — NUNCA expor no client nem marcar como pública na Vercel
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# URL do site (redirects Auth, links absolutos, sitemap, Search Console)
NEXT_PUBLIC_SITE_URL=https://www.gauchinhoconsorcios.com.br

# Google Calendar — sincronização da agenda comercial (servidor)
# Crie credenciais OAuth "Web application" no Google Cloud Console
# Redirect URI autorizado: {NEXT_PUBLIC_SITE_URL}/api/auth/google-calendar/callback
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# IA comercial (servidor — opcional; sem chave o chat usa fallback + WhatsApp)
OPENAI_API_KEY=
IA_PROVIDER=openai
IA_MODEL=gpt-4o-mini

# Integração privada com o ERP Consórcio (somente servidor)
# Gere uma chave longa e use exatamente o mesmo valor nos dois projetos.
GAUCHINHO_INTEGRATION_API_KEY=

# Produção (Vercel): cadastre as mesmas chaves em Production + Preview
# NEXT_PUBLIC_SITE_URL=https://seu-app.vercel.app

# Automação de domínios da Platform (adiciona no projeto Vercel e consulta DNS exato)
# Token pessoal/de equipe com acesso ao projeto guachinho-site. Nunca exponha como NEXT_PUBLIC_*.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=prj_rcdKOewLz7V2FXEvmn3qHlyMiKMT
VERCEL_TEAM_ID=team_dDXF2nqwNnCGn3FUEGHwcYNA

# Segredo usado pela Vercel Cron para verificar DNS/HTTPS pendentes automaticamente.
CRON_SECRET=

# =========================================================
# WhatsApp Cloud API — multiempresa / coexistência (Fase 310)
# App único da Meta "MENSAGENS GAUCHINHO"; cada franquia conecta o próprio número.
# =========================================================
# Público (usado no client do Embedded Signup)
NEXT_PUBLIC_WHATSAPP_APP_ID=1412730744263214
NEXT_PUBLIC_WHATSAPP_CONFIG_ID=1582891326394697
NEXT_PUBLIC_WHATSAPP_GRAPH_VERSION=v23.0

# Servidor (NUNCA expor como NEXT_PUBLIC)
WHATSAPP_APP_ID=1412730744263214
WHATSAPP_CONFIG_ID=1582891326394697
WHATSAPP_APP_SECRET=            # App Secret do app da Meta (Configurações > Básico)
WHATSAPP_GRAPH_VERSION=v23.0
# Token que você define e cadastra também no webhook da Meta (string livre, forte)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Token dos números é cifrado no banco com a mesma chave dos robôs:
# reutiliza ROBO_CREDENTIALS_ENCRYPTION_KEY (ou fallback SUPABASE_SERVICE_ROLE_KEY)
